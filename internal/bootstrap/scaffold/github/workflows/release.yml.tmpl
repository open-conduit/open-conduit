name: Release

# Publishes a signed release archive for each platform when a tag v* is
# pushed. Each archive gets a Sigstore bundle beside it
# ({{NAME}}-VERSION_OS_ARCH.tar.gz.sigstore.json), a keyless signature by
# this workflow at that tag, which an operator's settings.extension_trust
# checks at install (see the README).

on:
  push:
    tags: ["v*"]

permissions:
  contents: read

jobs:
  release:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Create the release
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh release view "$GITHUB_REF_NAME" -R "$GITHUB_REPOSITORY" >/dev/null 2>&1 || gh release create "$GITHUB_REF_NAME" -R "$GITHUB_REPOSITORY" --title "$GITHUB_REF_NAME" --notes ""

  archive:
    needs: release
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, ubuntu-24.04-arm, macos-latest]
    runs-on: ${{ matrix.os }}
    permissions:
      contents: write # upload the archive to the release
      id-token: write # sign it as this workflow
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - uses: sigstore/cosign-installer@v3
      - name: Build the archive
        id: archive
        run: |
          make archive VERSION="${GITHUB_REF_NAME#v}"
          echo "file=$(make -s archive-name VERSION="${GITHUB_REF_NAME#v}")" >> "$GITHUB_OUTPUT"
      - name: Sign it
        run: cosign sign-blob --yes --bundle "${{ steps.archive.outputs.file }}.sigstore.json" "${{ steps.archive.outputs.file }}"
      - name: Upload it
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh release upload "$GITHUB_REF_NAME" -R "$GITHUB_REPOSITORY" "${{ steps.archive.outputs.file }}" "${{ steps.archive.outputs.file }}.sigstore.json" --clobber
