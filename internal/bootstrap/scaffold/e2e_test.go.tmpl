//go:build unix

package main

import (
	"strings"
	"testing"

	"github.com/open-conduit/open-conduit/extensiontest"
)

// TestAgentCallsHello builds this package, installs it in a real Open
// Conduit daemon and has a scripted agent call {{NAME}}.hello through its
// toolbelt, as a coding agent would.
func TestAgentCallsHello(t *testing.T) {
	d := extensiontest.Daemon(t, extensiontest.Package("."))
	agent := d.Agent().
		Call("{{NAME}}.hello", map[string]any{"name": "Ada"}).
		Ends("finished")

	work := d.Start("{{NAME}}.try", nil)
	if r := agent.Result(1, "{{NAME}}.hello"); r.IsError || !strings.Contains(r.Text, "Hello, Ada!") {
		t.Fatalf("{{NAME}}.hello: %+v", r)
	}
	d.WaitWork(work.ID, "completed")
}
