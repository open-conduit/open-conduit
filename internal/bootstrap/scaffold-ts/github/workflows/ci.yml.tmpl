name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: npm ci
      - run: make check

  # Lint and certify against Open Conduit's main branch and its latest
  # release, built from source.
  certify:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        open-conduit: [main, latest]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - uses: actions/setup-go@v5
        with:
          go-version: stable
      - run: go install github.com/open-conduit/open-conduit/cmd/open-conduit@${{ matrix.open-conduit }}
      - run: npm ci
      - run: make lint certify OPEN_CONDUIT="$(go env GOPATH)/bin/open-conduit"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: certification-${{ matrix.open-conduit }}
          path: dist/{{NAME}}.certification.json
          if-no-files-found: ignore
