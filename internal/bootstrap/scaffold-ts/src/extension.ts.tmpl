// {{NAME}}-extension is an Open Conduit extension package. It serves one
// toolbelt operation, {{NAME}}.hello, that agents call through Open
// Conduit. Start here: rename the operation, change its input and output,
// and say in its guidance when an agent should call it.

import { extension, OperationError, t } from "@open-conduit/sdk";

// The package's release, written into the manifest.
export const version = process.env.EXTENSION_VERSION ?? "0.1.0";

export function build() {
  // Each registration also declares itself, so the manifest
  // (`package-manifest`) is derived from what is registered here.
  return extension("{{NAME}}", {
    version,
    summary: "{{NAME}}: an Open Conduit extension package.",
    playbooks: "playbooks",
  })
    .operation("{{NAME}}.hello", {
      // The input's schema: required unless t.optional, with the
      // description an agent reads.
      input: t.object({ name: t.string({ description: "Who to greet." }) }),
      guidance: "Call `{{NAME}}.hello` with a `name` to get a greeting for them.",
      handler: ({ name }) => {
        const who = name.trim();
        if (who === "")
          throw new OperationError("bad_request", "{{NAME}}.hello needs a name");
        return { greeting: `Hello, ${who}!` };
      },
    })
    .certification({
      // The cases `open-conduit extension certify` runs the package
      // against: one per operation, with the output it must give.
      fixture: {
        operations: [
          {
            operation: "{{NAME}}.hello",
            input: { data: { name: "Ada" } },
            output: {
              schema: "{{NAME}}.hello.v1",
              data: { greeting: "Hello, Ada!" },
            },
          },
          {
            operation: "{{NAME}}.hello",
            input: { data: { name: " " } },
            error: "bad_request",
          },
        ],
      },
    });
}
