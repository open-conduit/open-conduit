{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/exec", {
      "prepareCmd": "mkdir -p .local && cat > .local/release-notes.md <<'SEMREL_NOTES'\n${nextRelease.notes}\nSEMREL_NOTES",
      "publishCmd": "goreleaser release --clean --release-notes .local/release-notes.md"
    }]
  ]
}
